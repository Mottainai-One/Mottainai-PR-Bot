# ============================================
# Mottainai PR Bot - Configuração
# Copie para .env e preencha os valores
# ============================================

# --- GitHub App ---
# ID do app (Settings > Developer settings > GitHub Apps)
APP_ID=
# Chave privada PEM gerada no app (em uma linha, com \n)
PRIVATE_KEY=
# Webhook secret definido na criacao do app
WEBHOOK_SECRET=
# Nome da organizacao (ex: Mottainai-One)
GITHUB_ORG=Mottainai-One
# Host para a URL do webhook (uso externo)
WEBHOOK_PROXY_URL=

# --- Regras de merge ---
# Quantidade minima de approvals para auto-merge
MIN_APPROVALS=2
# Nome dos repos ignorados (virgula, ex: ".github,mottainai-hub")
IGNORED_REPOS=
# Branches protegidas (nao recebem PR automatico), separadas por virgula
PROTECTED_BRANCHES=main,develop

# --- Gemini (IA) ---
# Chave de API do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo a ser usado
GEMINI_MODEL=gemini-1.5-flash
# Numero total de tentativas para erros temporarios (429, 5xx e falhas de rede)
GEMINI_MAX_ATTEMPTS=4
# Espera inicial entre tentativas; o valor dobra a cada falha (com jitter)
GEMINI_RETRY_BASE_DELAY_MS=2000

# --- Servidor ---
PORT=3000
# Base URL publica (para o GitHub chamar o webhook)
BASE_URL=http://localhost:3000

# --- Túnel de desenvolvimento (Smee) ---
# Crie um canal em https://smee.io/new e cole a URL aqui.
# O GitHub envia o webhook para esse canal, que repassa para o bot local.
SMEE_URL=
